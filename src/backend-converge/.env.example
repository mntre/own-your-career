# Google OAuth 2.0 Configuration
# Get these from Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Allowed emails (comma-separated, lowercase)
# Format: email1@example.com,email2@example.com
ALLOWED_EMAILS=user1@converge.com.ph,user2@converge.com.ph,user3@converge.com.ph

# JWT Secret (change in production - use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server Configuration
PORT=3000
NODE_ENV=development
